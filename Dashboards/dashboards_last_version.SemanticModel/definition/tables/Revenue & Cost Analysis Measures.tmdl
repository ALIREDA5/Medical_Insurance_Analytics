table 'Revenue & Cost Analysis Measures'
	lineageTag: 10d68512-ea0a-43a0-9889-9c2d9865d1d1
	sourceLineageTag: fb6f48c9-40a8-4fa8-b5d0-291d52a80879

	/// Total revenue from completed visits
	measure 'Total Revenue' = CALCULATE(SUM(fact_visits[total_cost]), fact_visits[visit_status] = "Completed")
		formatString: #,0.00
		displayFolder: Revenue
		lineageTag: dd8ec820-65c0-4262-899e-47dc541188ad

		changedProperty = IsHidden

	/// Total cost across all visits regardless of status
	measure 'Total Cost' = SUM(fact_visits[total_cost])
		formatString: #,0.00
		displayFolder: Cost
		lineageTag: a9f71b45-606b-4c40-a977-821ed2e9cb2b

		changedProperty = IsHidden

	/// Revenue divided by completed visits
	measure 'Revenue per Visit' = DIVIDE([Total Revenue], [Completed Visit Count])
		formatString: #,0.00
		displayFolder: Revenue
		lineageTag: 93a8bd75-d2ca-425b-83eb-df9983b0db42

		changedProperty = IsHidden

	/// Total cost divided by all visits including no-shows
	measure 'Avg Cost per Visit' = DIVIDE([Total Cost], [Visit Count])
		formatString: #,0.00
		displayFolder: Revenue
		lineageTag: 6927377b-2e09-4f7a-aaaa-1b9d47042622

		changedProperty = IsHidden

	/// Cost on no-show and cancelled visits
	measure 'Lost Revenue' = CALCULATE(SUM(fact_visits[total_cost]), fact_visits[visit_status] IN {"No Show", "Cancelled"})
		formatString: #,0.00
		displayFolder: Revenue
		lineageTag: 731166d5-04d3-4d5c-a843-864be9a3e3dc

		changedProperty = IsHidden

	/// Total cost divided by distinct patients
	measure 'Avg Cost per Patient' = DIVIDE([Total Cost], DISTINCTCOUNT(fact_visits[patient_key]))
		formatString: #,0.00
		displayFolder: Cost
		lineageTag: 84bb791c-d3d4-41fd-864c-b4e1494b1441

		changedProperty = IsHidden

	partition 'Revenue & Cost Analysis Measures' = entity
		mode: directQuery
		source
			entityName: Revenue & Cost Analysis Measures
			expressionSource: 'DirectQuery to AS - FinPro'

