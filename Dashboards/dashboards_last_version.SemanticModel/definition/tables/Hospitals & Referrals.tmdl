table 'Hospitals & Referrals'
	lineageTag: 3e15311b-9744-401f-89a8-a4c5e75cb583
	sourceLineageTag: 33fbcca4-f7dd-4a9a-8af1-1f25c5749f1d

	/// Total referrals
	measure 'Referral Count' = COUNTROWS(fact_referrals)
		formatString: #,0
		displayFolder: Volume
		lineageTag: ff4dfbb1-408e-4cd0-8136-7efe0e90c598

		changedProperty = IsHidden

	/// Referrals with status = Completed
	measure 'Completed Referral Count' = CALCULATE(COUNTROWS(fact_referrals), fact_referrals[referral_status] = "Completed")
		formatString: #,0
		displayFolder: Volume
		lineageTag: c6eda9a5-fe70-4bd6-bdce-146f32aa5fdb

		changedProperty = IsHidden

	/// Referrals with status = Pending
	measure 'Pending Referral Count' = CALCULATE(COUNTROWS(fact_referrals), fact_referrals[referral_status] = "Pending")
		formatString: #,0
		displayFolder: Volume
		lineageTag: 3959c1d3-f741-486b-b3d3-8bd589c76d59

		changedProperty = IsHidden

	/// Referrals with status = Cancelled
	measure 'Cancelled Referral Count' = CALCULATE(COUNTROWS(fact_referrals), fact_referrals[referral_status] = "Cancelled")
		formatString: #,0
		displayFolder: Volume
		lineageTag: 0636adcc-8305-49a5-9f39-e1d94ab235d6

		changedProperty = IsHidden

	/// Completed referrals / total referrals
	measure 'Completed Referral Rate' = DIVIDE([Completed Referral Count], [Referral Count])
		formatString: 0.00%
		displayFolder: Rates
		lineageTag: 8094e72a-fa9b-47a4-b292-e308ca4e8752

		changedProperty = IsHidden

	/// Pending referrals / total referrals
	measure 'Pending Referral Rate' = DIVIDE([Pending Referral Count], [Referral Count])
		formatString: 0.00%
		displayFolder: Rates
		lineageTag: 15ebd773-0066-4052-8d2e-62ed371662a1

		changedProperty = IsHidden

	/// Cancelled referrals / total referrals
	measure 'Cancelled Referral Rate' = DIVIDE([Cancelled Referral Count], [Referral Count])
		formatString: 0.00%
		displayFolder: Rates
		lineageTag: 5c343850-115f-4c21-94eb-afbc1c5980b8

		changedProperty = IsHidden

	/// Distinct originating hospitals
	measure 'Referring Hospital Count' = DISTINCTCOUNT(fact_referrals[from_hospital_key])
		formatString: #,0
		displayFolder: Volume
		lineageTag: a8cd385d-8066-42d8-9463-e5dab8d81904

		changedProperty = IsHidden

	/// Distinct receiving hospitals
	measure 'Receiving Hospital Count' = DISTINCTCOUNT(fact_referrals[to_hospital_key])
		formatString: #,0
		displayFolder: Volume
		lineageTag: 7fdc04fb-983e-4b5d-ab27-0d73627878a8

		changedProperty = IsHidden

	/// Claim risk 0-100: 50% slow decisions + 50% high-item rate
	measure 'Claim Risk Score' =
			VAR _slow = [Slow Decision Rate]
			VAR _hi = [High Item Claim Rate]
			RETURN ROUND(MIN((_slow * 50 + _hi * 50) * 100, 100), 1)
		formatString: 0.0
		displayFolder: Risk Score
		lineageTag: 75d4e86f-08ae-4d2d-b264-de3c6aa36786

		changedProperty = IsHidden

	/// Pharmacy risk 0-100: 60% no-prescription + 40% stockout rate
	measure 'Pharmacy Risk Score' = ROUND(MIN(([No-Prescription Rate] * 60 + [Stockout Rate] * 40) * 100, 100), 1)
		formatString: 0.0
		displayFolder: Risk Score
		lineageTag: 403406db-17ec-4050-acff-3de40263e247

		changedProperty = IsHidden

	/// Weighted overall risk 0-100: 50% claim + 30% pharmacy + 20% no-show
	measure 'Overall Risk Score' =
			ROUND(
			    [Claim Risk Score] * 0.5
			    + [Pharmacy Risk Score] * 0.3
			    + MIN([No-Show Rate] * 100, 100) * 0.2
			, 1)
		formatString: 0.0
		displayFolder: Risk Score
		lineageTag: 439f3c5d-37fe-4799-ab7f-7ef52701fe53

		changedProperty = IsHidden

	/// Active risk flags: no-show>8%, rejection>15%, no-rx>50%, stockout>5%, claim/expected>10
	measure 'Risk Flag Count' =
			VAR _f1 = IF([No-Show Rate] > 0.08, 1, 0)
			VAR _f2 = IF([Rejection Rate] > 0.15, 1, 0)
			VAR _f3 = IF([No-Prescription Rate] > 0.5, 1, 0)
			VAR _f4 = IF([Stockout Rate] > 0.05, 1, 0)
			VAR _f5 = IF([Claim Inflation Ratio] > 10, 1, 0)
			RETURN _f1 + _f2 + _f3 + _f4 + _f5
		formatString: #,0
		displayFolder: Risk Score
		lineageTag: 3ab6ab7c-5baa-46e9-bbc2-969732c43152

		changedProperty = IsHidden

	/// Estimated financial exposure from fraud proxy signals
	measure 'Fraud Exposure Estimate' = ([Excess Claim Amount] + [No-Prescription Dispensing Value]) * 0.8
		formatString: #,0.00
		displayFolder: Risk Score
		lineageTag: 2ac93e0c-9dab-412a-9c09-f01a4a61f0e0

		changedProperty = IsHidden

	column Column
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 778820d9-61a4-45ce-812b-5046acab8e70
		sourceLineageTag: fcf75c72-4ded-40c9-8de5-b12c6c83dcb8
		dataCategory: Uncategorized
		summarizeBy: sum
		sourceColumn: Column

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	partition 'Hospitals & Referrals' = entity
		mode: directQuery
		source
			entityName: Hospitals & Referrals
			expressionSource: 'DirectQuery to AS - FinPro'

