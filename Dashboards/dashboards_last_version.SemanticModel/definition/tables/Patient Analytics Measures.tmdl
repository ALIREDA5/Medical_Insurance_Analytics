table 'Patient Analytics Measures'
	lineageTag: 15aed8f8-ec03-4bb7-9c80-b49ece40122c
	sourceLineageTag: 60c22ea0-5624-4f94-91a9-8d789c6c03e4

	/// Distinct patients in dim_patient
	measure 'Patient Count' = DISTINCTCOUNT(dim_patient[patient_key])
		formatString: #,0
		displayFolder: Demographics
		lineageTag: b9caa5c1-c0f6-4e44-8ac8-b464bedaecf7

		changedProperty = IsHidden

	/// Male patients count
	measure 'Male Patient Count' = CALCULATE(DISTINCTCOUNT(dim_patient[patient_key]), dim_patient[gender] = "Male")
		formatString: #,0
		displayFolder: Demographics
		lineageTag: 10cbd714-40d9-4070-91dd-1db6d048ca60

		changedProperty = IsHidden

	/// Female patients count
	measure 'Female Patient Count' = CALCULATE(DISTINCTCOUNT(dim_patient[patient_key]), dim_patient[gender] = "Female")
		formatString: #,0
		displayFolder: Demographics
		lineageTag: 8ce0193c-6dc4-48f3-acd8-70f2d4068c56

		changedProperty = IsHidden

	/// Average patient age from dim_patient
	measure 'Avg Patient Age' = AVERAGE(dim_patient[Age])
		formatString: #,0.0
		displayFolder: Demographics
		lineageTag: 3ed3e4b2-db9c-443e-a765-91c0e06d22f1

		changedProperty = IsHidden

	/// Total visits divided by distinct patients with visits
	measure 'Avg Visits per Patient' = DIVIDE([Visit Count], DISTINCTCOUNT(fact_visits[patient_key]))
		formatString: 0.0
		displayFolder: Behavior
		lineageTag: 8cd52ea2-3c76-4a6a-a38b-c42b0ee1e06c

		changedProperty = IsHidden

	/// Patients with more than one visit / total patients with visits
	measure 'Returning Patient Rate' =
			VAR _vc = SUMMARIZE(fact_visits, fact_visits[patient_key], "cnt", COUNTROWS(fact_visits))
			RETURN DIVIDE(COUNTROWS(FILTER(_vc, [cnt] > 1)), COUNTROWS(_vc))
		formatString: 0.00%
		displayFolder: Behavior
		lineageTag: c8423812-c916-4764-b400-6fe908ef783d

		changedProperty = IsHidden

	/// Active doctors in dim_doctor
	measure 'Active Doctor Count' = CALCULATE(DISTINCTCOUNT(dim_doctor[doctor_key]), dim_doctor[employment_status] = "Active")
		formatString: #,0
		displayFolder: Staff
		lineageTag: 7ccbd8a2-0e71-4220-baf1-4c1050cdb883

		changedProperty = IsHidden

	/// Distinct departments in dim_department
	measure 'Department Count' = DISTINCTCOUNT(dim_department[department_key])
		formatString: #,0
		displayFolder: Staff
		lineageTag: fbc12f07-ff01-44d4-a9f7-82f6d6c153cd

		changedProperty = IsHidden

	/// Distinct diagnosis keys recorded in visits
	measure 'Diagnosis Count' = DISTINCTCOUNT(fact_visits[diagnosis_key])
		formatString: #,0
		displayFolder: Clinical
		lineageTag: e19a40d5-ae92-473f-a327-baf3dde5ce5b

		changedProperty = IsHidden

	/// Distinct diagnosis types in dim_diagnosis
	measure 'Diagnosis Type Count' = DISTINCTCOUNT(dim_diagnosis[diagnosis_key])
		formatString: #,0
		displayFolder: Clinical
		lineageTag: 1aa91106-42b4-485c-8b5a-8e8188d87196

		changedProperty = IsHidden

	partition 'Patient Analytics Measures' = entity
		mode: directQuery
		source
			entityName: Patient Analytics Measures
			expressionSource: 'DirectQuery to AS - FinPro'

