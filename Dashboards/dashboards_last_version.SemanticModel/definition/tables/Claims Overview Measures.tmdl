table 'Claims Overview Measures'
	lineageTag: 2523fbfe-566f-4635-adc1-2c3d774cb1f1
	sourceLineageTag: 7965d624-52d5-43dd-8446-6786691587cd

	/// Total number of claims
	measure 'Claim Count' = COUNTROWS(fact_claims)
		formatString: #,0
		displayFolder: Volume
		lineageTag: 06676073-5fd5-46dd-8d13-4cce2ed0decc

		changedProperty = IsHidden

	/// Sum of all claimed amounts
	measure 'Claimed Amount' = SUM(fact_claims[claim_amount])
		formatString: #,0.00
		displayFolder: Financials
		lineageTag: a8a8d8bd-2eb7-4d5b-847c-a991f1847188

		changedProperty = IsHidden

	/// Sum of approved amounts on approved claims
	measure 'Approved Amount' = CALCULATE(SUM(fact_claims[approved_amount]), fact_claims[approval_status] = "Approved")
		formatString: #,0.00
		displayFolder: Financials
		lineageTag: 839a81fe-c308-4fb6-9fbb-d54f7d893e71

		changedProperty = IsHidden

	/// Approved claims / total claims
	measure 'Approval Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_claims), fact_claims[approval_status] = "Approved"), [Claim Count])
		formatString: 0.00%
		displayFolder: Rates
		lineageTag: 263665f3-5c5a-4be0-94aa-73a6a8848b8c

		changedProperty = IsHidden

	/// Rejected claims / total claims
	measure 'Rejection Rate' = DIVIDE(CALCULATE(COUNTROWS(fact_claims), fact_claims[approval_status] = "Rejected"), [Claim Count])
		formatString: 0.00%
		displayFolder: Rates
		lineageTag: 1874bd43-f43e-4cff-a6c7-23b2e71f066d

		changedProperty = IsHidden

	/// Average claim amount per claim
	measure 'Avg Claim Amount' = DIVIDE([Approved Amount], [Claim Count])
		formatString: #,0.00
		displayFolder: Financials
		lineageTag: 705a7147-26a7-415a-b5ff-93e6f6fd6f02

		changedProperty = IsHidden

	/// Total gap between claimed and approved amounts
	measure 'Approval Gap Amount' = SUM(fact_claims[approval_gap])
		formatString: #,0.00
		displayFolder: Financials
		lineageTag: c4aea015-5725-4b8b-bdee-36c30d2d5d93

		changedProperty = IsHidden

	/// Approval gap as % of total claimed
	measure 'Approval Gap Rate' = DIVIDE([Approval Gap Amount], [Claimed Amount])
		formatString: 0.00%
		displayFolder: Rates
		lineageTag: 708c57bb-b0b8-4a08-b07c-c2fbacf7bd66

		changedProperty = IsHidden

	/// Average days to decision, excludes pending (days_to_decision = 0)
	measure 'Avg Decision Days' = AVERAGEX(FILTER(fact_claims, fact_claims[days_to_decision] > 0), fact_claims[days_to_decision])
		formatString: #,0.0
		displayFolder: Efficiency
		lineageTag: 3a47ed8e-a09e-4de6-b647-57799826220e

		changedProperty = IsHidden

	/// Claims with days_to_decision >= 21 (top delay quartile, data range 1-30)
	measure 'Slow Decision Count' = CALCULATE(COUNTROWS(fact_claims), fact_claims[days_to_decision] >= 21)
		formatString: #,0
		displayFolder: Risk
		lineageTag: 06f3fb56-9a2e-475e-88a5-3fb59bf4e846

		changedProperty = IsHidden

	/// Slow decision claims / all decided claims
	measure 'Slow Decision Rate' = DIVIDE([Slow Decision Count], CALCULATE(COUNTROWS(fact_claims), fact_claims[days_to_decision] > 0))
		formatString: 0.00%
		displayFolder: Risk
		lineageTag: 36086544-429c-459e-927b-1b9876c5c323

		changedProperty = IsHidden

	/// Claims with more than 5 line items in fact_claim_items
	measure 'High Item Claim Count' =
			VAR _items = SUMMARIZE(fact_claim_items, fact_claim_items[claim_id], "n", COUNTROWS(fact_claim_items))
			RETURN COUNTROWS(FILTER(_items, [n] > 5))
		formatString: #,0
		displayFolder: Risk
		lineageTag: 0d4bf5bc-96bb-4a89-97d1-596ec09da060

		changedProperty = IsHidden

	/// High item claims / total claims
	measure 'High Item Claim Rate' = DIVIDE([High Item Claim Count], [Claim Count])
		formatString: 0.00%
		displayFolder: Risk
		lineageTag: dfe09869-b566-400e-9df4-32d355c4274c

		changedProperty = IsHidden

	/// Expected amount based on procedure standard cost x quantity
	measure 'Expected Claim Amount' = SUMX(fact_claim_items, RELATED(dim_procedure[expected_amount]) * fact_claim_items[item_quantity])
		formatString: #,0.00
		displayFolder: Risk
		lineageTag: 64c2537c-832e-45e7-a835-696d47d1b42d

		changedProperty = IsHidden

	/// Total claimed / expected procedure amount
	measure 'Claim Inflation Ratio' = DIVIDE([Claimed Amount], [Expected Claim Amount])
		formatString: 0.00
		displayFolder: Risk
		lineageTag: 789c3c7b-b1d6-4d27-9341-28d401cb0cf6

		changedProperty = IsHidden

	/// Amount claimed above expected — floored at 0
	measure 'Excess Claim Amount' = MAX([Claimed Amount] - [Expected Claim Amount], 0)
		formatString: #,0.00
		displayFolder: Risk
		lineageTag: 9fc3e442-8e9f-475e-b460-7a726f232111

		changedProperty = IsHidden

	partition 'Claims Overview Measures' = entity
		mode: directQuery
		source
			entityName: Claims Overview Measures
			expressionSource: 'DirectQuery to AS - FinPro'

