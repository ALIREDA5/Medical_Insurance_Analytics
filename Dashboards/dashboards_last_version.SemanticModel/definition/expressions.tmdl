expression 'DirectQuery to AS - FinPro' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/UHIP", "FinPro"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
		in
		    Cube
	lineageTag: 26c1af48-ee2f-46d6-818a-d1993852f51b

