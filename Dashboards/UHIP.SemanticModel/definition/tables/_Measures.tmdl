table _Measures
	lineageTag: a1559c5f-bad2-4698-8408-83e377998a50

	measure 'Total Visits' =
			
			COUNTROWS(fact_visits)
		formatString: #,0
		displayFolder: Overview
		lineageTag: 42cdbad1-13d4-4ea0-8fa4-6eee3c886709

	measure 'No-Show Rate %' =
			
			DIVIDE(
			    CALCULATE(COUNTROWS(fact_visits), fact_visits[visit_status] = "No Show"),
			    [Total Visits]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Operations & Service
		lineageTag: d5746222-62fc-402f-82a7-5f650c9df8d3

	measure 'Cancellation Rate %' =
			
			DIVIDE(
			    CALCULATE(COUNTROWS(fact_visits), fact_visits[visit_status] = "Cancelled"),
			    [Total Visits]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Operations & Service
		lineageTag: 23477654-0367-4098-8ef3-b8be3dd99f62

	measure 'Avg Waiting Time - Completed' =
			
			CALCULATE(
			    AVERAGE(fact_visits[waiting_time]),
			    fact_visits[visit_status] = "Completed",
			    fact_visits[waiting_time] > 0
			)
		formatString: 0 "min"
		displayFolder: Operations & Service
		lineageTag: b21eb394-01ad-4e9d-85f3-2484d483a11d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Prescription Rate %' =
			
			DIVIDE(
			    CALCULATE(COUNTROWS(fact_visits), fact_visits[prescription_flag] = 1),
			    [Total Visits]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Operations & Service
		lineageTag: 6a8ea9b5-025f-4b4b-881c-a4527dbad5a8

	measure 'Avg Waiting Time - All' =
			
			AVERAGE(fact_visits[waiting_time])
		formatString: 0 "min"
		displayFolder: Operations & Service
		lineageTag: c176404f-90f8-4285-8340-9c0ddc18ba77

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'No Prescription Share of Pharmacy Transactions %' =
			
			DIVIDE([No Prescription Transactions], [Pharmacy Transactions])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Pharmacy
		lineageTag: 8c94346b-16cc-4b0b-ac5c-ff716bff145b

	measure 'Visits Last Month' = CALCULATE ( [Total Visits], DATEADD ( dim_date[full_date], -1, MONTH ) )
		formatString: #,0
		displayFolder: Operations & Service\Trends
		lineageTag: 652225d0-ce5a-4e62-bced-899ca553c944

	measure 'Visits MoM %' =
			VAR Prev = [Visits Last Month]
			RETURN DIVIDE ( [Total Visits] - Prev, Prev )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Operations & Service\Trends
		lineageTag: f42c80c3-13dd-4dac-9676-8cc0e48c8433

	measure 'High Satisfaction %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( fact_visits ), fact_visits[feedback_rating] >= 4 ),
			    CALCULATE ( COUNTROWS ( fact_visits ), NOT ISBLANK ( fact_visits[feedback_rating] ) )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Operations & Service
		lineageTag: 8e851284-3641-46c5-aae2-33cd80354b4d

	measure 'Avg Feedback Rating' =
			
			AVERAGE(fact_visits[feedback_rating])
		displayFolder: Operations & Service
		lineageTag: 14993722-9bf9-49c9-92d2-2b90bd5c85dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Visits Per Doctor' =
			
			DIVIDE(
			    COUNTROWS(fact_visits),
			    DISTINCTCOUNT(fact_visits[doctor_key])
			)
		formatString: #,0
		displayFolder: Doctors & Departments
		lineageTag: 4b45428f-8754-4c38-a35e-c0fbc9c00149

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Low Rating Visits %' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(fact_visits),
			        fact_visits[feedback_rating] <= 2
			    ),
			    CALCULATE(
			        COUNTROWS(fact_visits),
			        fact_visits[feedback_rating] <> BLANK()
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Operations & Service
		lineageTag: 496fb61f-9b8b-4356-a75b-acb6d672af62

	measure 'Total Patients' =
			
			DISTINCTCOUNT(fact_visits[patient_key])
		formatString: #,0
		displayFolder: Overview
		lineageTag: 344af192-ebb9-4bff-874d-a407ecdf89bf

	measure 'Avg Visits Per Patient' =
			
			DIVIDE(
			    COUNTROWS(fact_visits),
			    DISTINCTCOUNT(fact_visits[patient_key])
			)
		displayFolder: Patients
		lineageTag: 056fec2b-3a3f-45ac-90ba-013be03a1167

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Returning Patients %' =
			
			VAR Returning =
			    COUNTROWS ( FILTER ( VALUES ( fact_visits[patient_key] ), CALCULATE ( COUNTROWS ( fact_visits ) ) > 1 ) )
			RETURN
			DIVIDE ( Returning, [Total Patients] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Patients
		lineageTag: 1c123d52-d64b-4235-9566-175aea8c1596

	measure 'Avg Patient Age' =
			
			AVERAGE(dim_patient[Age])
		formatString: 0
		displayFolder: Patients
		lineageTag: 56d7fe8b-80bb-43a2-b9da-f94d71bcf097

	measure 'Total Revenue' =
			
			SUM(fact_visits[total_cost])
		formatString: #,0 "EGP";-#,0 "EGP";0 "EGP"
		displayFolder: Financial
		lineageTag: d28106b7-4a90-45ab-b53e-778cdd1df6e1

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Revenue Per Visit' =
			
			AVERAGE(fact_visits[total_cost])
		formatString: #,0 "EGP";-#,0 "EGP";0 "EGP"
		displayFolder: Financial
		lineageTag: 3e013e75-882f-42ea-91a5-1fb35fe9f858

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Revenue Per Completed Visit' =
			
			CALCULATE(
			    AVERAGE(fact_visits[total_cost]),
			    fact_visits[visit_status] = "Completed"
			)
		formatString: #,0 "EGP";-#,0 "EGP";0 "EGP"
		displayFolder: Financial
		lineageTag: 124abe38-e7d7-4a51-bbda-7d0ba9a83ff4

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Estimated Lost Revenue' =
			
			VAR AvgCompletedVisitCost =
			    CALCULATE(
			        AVERAGE(fact_visits[total_cost]),
			        fact_visits[visit_status] = "Completed"
			    )
			VAR MissedVisits =
			    CALCULATE(
			        COUNTROWS(fact_visits),
			        fact_visits[visit_status] IN {"No Show", "Cancelled"}
			    )
			RETURN
			    AvgCompletedVisitCost * MissedVisits
		formatString: #,0 "EGP";-#,0 "EGP";0 "EGP"
		displayFolder: Financial
		lineageTag: bccd7e9d-12ed-4001-bf27-ee61032c5a27

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Revenue Last Month' = CALCULATE ( [Total Revenue], DATEADD ( dim_date[full_date], -1, MONTH ) )
		formatString: #,0 "EGP";-#,0 "EGP";0 "EGP"
		displayFolder: Financial\Trends
		lineageTag: 2f308a50-b732-425e-b016-589af901eaf2

	measure 'Revenue MoM %' =
			VAR Prev = [Revenue Last Month]
			RETURN DIVIDE ( [Total Revenue] - Prev, Prev )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Financial\Trends
		lineageTag: 1e299934-3706-4a72-8083-cfc1410dae50

	measure 'Total Claims Count' =
			
			DISTINCTCOUNT(fact_claims[claim_id])
		formatString: #,0
		displayFolder: Overview
		lineageTag: d934bdce-f1b1-4fbb-a0ab-65c5b9d2098b

	measure 'Total Claimed Amount' = SUM(fact_claims[claim_amount])
		formatString: #,0 "EGP";-#,0 "EGP";0 "EGP"
		displayFolder: Claims
		lineageTag: da4371fb-6e5b-4bdd-a28e-5ea90cbd9e41

