	measure 'Near Expiry Rate' =
			
			DIVIDE([Near Expiry Transactions], [Pharmacy Transactions])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Pharmacy
		lineageTag: 1c0d6e0c-d064-4a1f-8038-d450fef21062

	measure 'Total Drug Items' = COUNTROWS(dim_drug)
		formatString: #,0
		displayFolder: Pharmacy
		lineageTag: 4efba8a6-dba0-4239-ada1-447bf705c744

	measure 'Stock Value at Risk' =
			
			CALCULATE(
			    SUMX(fact_pharmacy, fact_pharmacy[quantity] * fact_pharmacy[unit_amount]),
			    fact_pharmacy[stockout_flag] = 1
			)
		formatString: #,0 "EGP";-#,0 "EGP";0 "EGP"
		displayFolder: Pharmacy
		lineageTag: 13943f83-e8a4-4dc5-aac2-55c4814dd854

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Expiry Loss Value' =
			
			CALCULATE(
			    SUMX(fact_pharmacy, fact_pharmacy[quantity] * fact_pharmacy[unit_amount]),
			    fact_pharmacy[near_expiry_flag] = 1
			)
		formatString: #,0 "EGP";-#,0 "EGP";0 "EGP"
		displayFolder: Pharmacy
		lineageTag: a2f79f72-2c49-4df9-8ac4-36cb97c5dca2

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Avg Dispensing per Transaction' =
			
			DIVIDE(
			    [Dispensed Quantity],
			    [Pharmacy Transactions],
			    0
			)
		displayFolder: Pharmacy
		lineageTag: aaaf225e-bf9d-4796-9fbf-0cc15cadf568

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'No Prescription Loss Value' =
			
			CALCULATE(
			    SUMX(fact_pharmacy, fact_pharmacy[quantity] * fact_pharmacy[unit_amount]),
			    fact_pharmacy[no_prescription_flag] = 1
			)
		formatString: #,0
		displayFolder: Pharmacy
		lineageTag: c11dfbcc-21f9-40bb-b2b2-e988b8eb434b

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Stock Health Score' =
			
			VAR StockoutPenalty = [Stockout Rate] * 50
			VAR ExpiryPenalty = [Near Expiry Rate] * 30
			VAR NoPrescPenalty = [No Prescription Rate] * 20
			RETURN
			    100 - StockoutPenalty - ExpiryPenalty - NoPrescPenalty
		displayFolder: Pharmacy
		lineageTag: 9df87595-1b3d-446c-a644-ee3d89523d3c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Quantity MoM Change' =
			
			VAR CurrentMonth = [Dispensed Quantity]
			VAR PrevMonth = CALCULATE(
			    [Dispensed Quantity],
			    DATEADD(dim_date[full_date], -1, MONTH)
			)
			RETURN
			DIVIDE(CurrentMonth - PrevMonth, PrevMonth, 0)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Pharmacy
		lineageTag: bdf90bdd-c508-44b7-9f0c-9cfc167ca31d

	measure 'Avg Transaction Value' =
			
			DIVIDE(
			    [Pharmacy Value],
			    [Pharmacy Transactions],
			    0
			)
		formatString: #,0 "EGP";-#,0 "EGP";0 "EGP"
		displayFolder: Pharmacy
		lineageTag: c2c848be-e562-4dc2-9a5c-20b0e2c63912

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Top Drug Category' =
			
			CALCULATE(
			    FIRSTNONBLANK(dim_drug[drug_category], 1),
			    TOPN(1, ALL(dim_drug[drug_category]),
			    [Dispensed Quantity], DESC)
			)
		displayFolder: Pharmacy
		lineageTag: 69409b52-48d5-491a-b5df-e635f06a3fce

	measure 'Prescription-Backed Dispensing %' =
			
			1 - DIVIDE ( [No Prescription Transactions], [Dispensing Transactions] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Pharmacy
		lineageTag: 503d2f22-cfdd-4f41-a23a-35baf903d8b6

	measure 'Avg Drug Cost per Visit' =
			
			DIVIDE(
			    [Pharmacy Value],
			    DISTINCTCOUNT(fact_visits[visit_id]),
			    0
			)
		formatString: #,0
		displayFolder: Pharmacy
		lineageTag: a62133cc-1a40-4332-a57b-1d8d775d2955

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'No Prescription Rate Among Dispensing %' =
			
			DIVIDE([No Prescription Transactions], [Dispensing Transactions])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Pharmacy
		lineageTag: d9d13623-48e0-4e74-b0b1-080c21d652e3

	measure 'Dispensing Transactions' =
			
			CALCULATE([Pharmacy Transactions], fact_pharmacy[transaction_type] = "Dispensing")
		formatString: 0
		displayFolder: Pharmacy
		lineageTag: 96c3e00c-16c6-49ec-813a-c3a14904538a

	measure 'Dispensed Quantity by Region' =
			
			[Dispensed Quantity]
		formatString: 0
		displayFolder: Pharmacy
		lineageTag: 7bcb0590-f929-45c6-830b-e6a2cdb7892f

	measure 'Slow Decision Claims' =
			
			CALCULATE(
			    [Total Claims Count],
			    fact_claims[days_to_decision] > 20
			)
		formatString: 0
		displayFolder: Fraud & Risk
		lineageTag: 0ea0e8e9-dc07-4a75-98ff-7ad9b60785be

	measure 'Slow Decision Rate %' =
			
			DIVIDE([Slow Decision Claims], [Total Claims Count])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Fraud & Risk
		lineageTag: 1f016b83-f575-4a18-b8d8-f6f2812780ce

	measure 'High Item Claims' =
			
			CALCULATE(
			    [Total Claims Count],
			    fact_claim_items[item_quantity] >= 5
			)
		formatString: 0
		displayFolder: Fraud & Risk
		lineageTag: 7175af51-ac83-47aa-95be-4c3790e241fe

	measure 'High Item Claim Rate %' =
			
			DIVIDE([High Item Claims], [Total Claims Count])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Fraud & Risk
		lineageTag: 51b26bd4-4641-4ead-bf33-70ab65056669

	measure 'Claim Risk Score' =
			
			VAR GapRaw =
			    COALESCE([Approval Gap Rate %], 0)
			VAR RejectionRaw =
			    COALESCE([Rejection Rate %], 0)
			VAR SlowRaw =
			    COALESCE([Slow Decision Rate %], 0)
			VAR ItemRaw =
			    COALESCE([High Item Claim Rate %], 0)
			
			VAR GapRisk =
			    IF(GapRaw > 1, GapRaw / 100, GapRaw)
			VAR RejectionRisk =
			    IF(RejectionRaw > 1, RejectionRaw / 100, RejectionRaw)
			VAR SlowRisk =
			    IF(SlowRaw > 1, SlowRaw / 100, SlowRaw)
			VAR ItemRisk =
			    IF(ItemRaw > 1, ItemRaw / 100, ItemRaw)
			
			VAR Score =
			    100 * (
			        0.35 * GapRisk +
			        0.25 * RejectionRisk +
			        0.20 * SlowRisk +
			        0.20 * ItemRisk
			    )
			RETURN
			MIN(
			    100,
			    Score
			)
		formatString: 0.0
		displayFolder: Fraud & Risk
		lineageTag: 16386ade-2521-4329-9265-a407c2b41afe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pharmacy Risk Score' =
			
			VAR NoPrescriptionRisk = [No Prescription Rate]
			VAR StockoutRisk = [Stockout Rate]
			VAR ExpiryRisk = [Near Expiry Rate]
			RETURN
			MIN(
			    100,
			    100 * (
			        0.50 * NoPrescriptionRisk +
			        0.30 * StockoutRisk +
			        0.20 * ExpiryRisk
			    )
			)
		formatString: 0.0
		displayFolder: Fraud & Risk
		lineageTag: 4b4045ae-602c-487d-b119-1ccc261877f3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Overall Risk Score' =
			
			DIVIDE([Claim Risk Score] + [Pharmacy Risk Score], 2)
		formatString: 0.0
		displayFolder: Fraud & Risk
		lineageTag: 9b5467fe-ed0a-4ef7-8772-1f0d21fa8575

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Risk Flag Count' =
			
			CALCULATE(
			    COUNT(fact_pharmacy[transaction_id]),
			    fact_pharmacy[no_prescription_flag] = 1
			        || fact_pharmacy[stockout_flag] = 1
			        || fact_pharmacy[near_expiry_flag] = 1
			)
		formatString: 0
		displayFolder: Fraud & Risk
		lineageTag: 9fc538a8-77d3-469c-b79e-5a47d2835af6

	measure 'High Risk Hospitals' =
			
			COUNTROWS (
			    FILTER ( VALUES ( dim_hospital[hospital_name] ), [Pharmacy Risk Score] >= 70 )
			)
		formatString: 0
		displayFolder: Fraud & Risk
		lineageTag: 6a55f9bb-e296-424a-86cd-c0bf4973a280

	measure 'Expected Procedure Amount' =
			
			VAR ComparableItems =
			    FILTER ( fact_claim_items, NOT ISBLANK ( RELATED ( dim_procedure[expected_amount] ) ) )
			RETURN
			SUMX ( ComparableItems, RELATED ( dim_procedure[expected_amount] ) * fact_claim_items[item_quantity] )
		formatString: #,0 "EGP";-#,0 "EGP";0 "EGP"
		displayFolder: Fraud & Risk
		lineageTag: a19ccc97-be39-46be-a63a-5992c7e309ba

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Claim vs Expected Ratio' =
			
			VAR ComparableItems =
			    FILTER ( fact_claim_items, NOT ISBLANK ( RELATED ( dim_procedure[expected_amount] ) ) )
			VAR Actual = SUMX ( ComparableItems, fact_claim_items[item_amount] )
			VAR Expected = SUMX ( ComparableItems, RELATED ( dim_procedure[expected_amount] ) * fact_claim_items[item_quantity] )
			RETURN
			DIVIDE ( Actual, Expected )
		formatString: 0.00
		displayFolder: Fraud & Risk
		lineageTag: 7f1a2ec1-017e-4f60-87a0-72270c7ff7f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Estimated Over Expected Amount' =
			
			SUMX (
			    FILTER ( fact_claim_items, NOT ISBLANK ( RELATED ( dim_procedure[expected_amount] ) ) ),
			    VAR ExpectedAmount = RELATED ( dim_procedure[expected_amount] ) * fact_claim_items[item_quantity]
			    VAR Difference = fact_claim_items[item_amount] - ExpectedAmount
			    RETURN IF ( Difference > 0, Difference, 0 )
			)
		formatString: #,0 "EGP";-#,0 "EGP";0 "EGP"
		displayFolder: Fraud & Risk
		lineageTag: 18fa37c3-6865-4352-b782-2ab2530f5521

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Operations Risk Score' =
			
			VAR NoShowRaw =
			    COALESCE([No-Show Rate %], 0)
			VAR CancelRaw =
			    COALESCE([Cancellation Rate %], 0)
			VAR LowRatingRaw =
			    COALESCE([Low Rating Visits %], 0)
			
			VAR NoShowRisk =
			    IF(NoShowRaw > 1, NoShowRaw / 100, NoShowRaw)
			VAR CancelRisk =
			    IF(CancelRaw > 1, CancelRaw / 100, CancelRaw)
			VAR LowRatingRisk =
			    IF(LowRatingRaw > 1, LowRatingRaw / 100, LowRatingRaw)
			
			VAR WaitingRisk =
			    MIN(
			        1,
			        DIVIDE([Avg Waiting Time - Completed], 120)
			    )
			
			VAR Score =
			    100 * (
			        0.35 * WaitingRisk +
			        0.25 * NoShowRisk +
			        0.20 * CancelRisk +
			        0.20 * LowRatingRisk
			    )
			RETURN
			MIN(
			    100,
			    Score
			)
		displayFolder: Fraud & Risk
		lineageTag: 23e276a0-1eeb-491a-bfb3-d5d1eb3736a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Estimated Fraud Proxy Loss' =
			
			[Estimated Over Expected Amount] +
			[No Prescription Loss Value] +
			[Expiry Loss Value]
		formatString: #,0
		displayFolder: Fraud & Risk
		lineageTag: ce45869d-db4c-4326-9503-42d82da22aa1

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Claim Items Amount' =
			
			SUMX(fact_claim_items, fact_claim_items[item_amount])
		formatString: #,0 "EGP";-#,0 "EGP";0 "EGP"
		displayFolder: Fraud & Risk
		lineageTag: 66f8c84e-a18f-4216-b622-73076e2ce140

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Overbilled Items' =
			COUNTROWS (
			    FILTER ( fact_claim_items,
			        VAR Expected = RELATED ( dim_procedure[expected_amount] ) * fact_claim_items[item_quantity]
			        RETURN Expected > 0 && fact_claim_items[item_amount] > 1.5 * Expected ) )
		formatString: #,0
		displayFolder: Fraud & Risk
		lineageTag: 71a2e024-f465-4729-8da3-5b04aac13d8f

	measure 'Overbilled Excess Amount' =
			SUMX (
			    FILTER ( fact_claim_items,
			        VAR Expected = RELATED ( dim_procedure[expected_amount] ) * fact_claim_items[item_quantity]
			        RETURN Expected > 0 && fact_claim_items[item_amount] > 1.5 * Expected ),
			    fact_claim_items[item_amount] - ( RELATED ( dim_procedure[expected_amount] ) * fact_claim_items[item_quantity] ) )
		formatString: #,0 "EGP";-#,0 "EGP";0 "EGP"
		displayFolder: Fraud & Risk
		lineageTag: d88075c3-8b29-4cff-ae7e-5476184eaf4c

	measure 'Total Doctors' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_doctor[doctor_key]),
