		lineageTag: b5985f77-1e3d-4345-ae8b-27c0cd68ffaf

	measure 'Cancelled Referral %' =
			
			DIVIDE(
			    [Cancelled Referrals],
			    CALCULATE(
			        DISTINCTCOUNT(fact_referrals[referral_id]),
			        ALL(fact_referrals[referral_status])
			    ),
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Hospitals & Referrals
		lineageTag: 20d9405a-6319-4a48-aab8-93006b8172e0

	measure 'Completed Referral %' =
			
			DIVIDE(
			    [Completed Referrals],
			    CALCULATE(
			        DISTINCTCOUNT(fact_referrals[referral_id]),
			        ALL(fact_referrals[referral_status])
			    ),
