		lineageTag: b8f0cf0b-9dd9-4240-b195-993f5612966b

	measure 'Near Expiry Transactions' =
			
			CALCULATE(
			    COUNT(fact_pharmacy[transaction_id]),
			    fact_pharmacy[near_expiry_flag] = 1
			)
		formatString: 0
