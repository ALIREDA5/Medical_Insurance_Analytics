		lineageTag: 1f758af2-bb61-4324-8f19-9250c8ac403a

	measure 'Partially Approved Claims' =
			
			CALCULATE([Total Claims Count], fact_claims[approval_status] = "Partially Approved")
		formatString: 0
		displayFolder: Claims
		lineageTag: 8dc73114-6d99-48bd-8337-153224643048

	measure 'Rejected Claims' =
			
			CALCULATE([Total Claims Count], fact_claims[approval_status] = "Rejected")
		formatString: 0
		displayFolder: Claims
		lineageTag: c22b8a4b-d899-4e0a-aa9a-16bc7eaf6887

	measure 'Pending Claims' =
			
			CALCULATE([Total Claims Count], fact_claims[approval_status] = "Pending Review")
		formatString: 0
		displayFolder: Claims
		lineageTag: 25e45586-d6e4-49cf-90b6-44419651833f

	measure 'Decided Claims' =
			
			[Total Claims Count] - [Pending Claims]
		formatString: 0
		displayFolder: Claims
		lineageTag: 18e0ae0a-858d-4bd9-ad6a-6a52f8c5e25e

	measure 'Accepted Claims Rate %' =
			
			DIVIDE([Approved Claims] + [Partially Approved Claims], [Total Claims Count])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Claims
		lineageTag: d07a3ce0-4b4f-4be3-bd63-237cd3e63048

	measure 'Claims Last Month' = CALCULATE ( [Total Claims Count], DATEADD ( dim_date[full_date], -1, MONTH ) )
		formatString: #,0
		displayFolder: Claims\Trends
		lineageTag: 983e7984-c2d1-4930-a7a0-6701bb5db930

	measure 'Claims MoM %' =
			VAR Prev = [Claims Last Month]
			RETURN DIVIDE ( [Total Claims Count] - Prev, Prev )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Claims\Trends
		lineageTag: c70c8f90-bf3e-453b-91c7-030d3b93c05d

	measure 'Approved Amount %' = DIVIDE ( [Total Approved Amount], [Total Claimed Amount] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Claims
		lineageTag: 509ba339-ebff-4e16-82c7-dc4be0ed121f

	measure 'Approval Gap' =
			
			SUM(fact_claims[claim_amount]) - SUM(fact_claims[approved_amount])
		formatString: #,0 "EGP";-#,0 "EGP";0 "EGP"
		displayFolder: Claims
		lineageTag: d8be471c-ba56-4e77-b47c-1504e1ea1d03

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Rejection Rate %' =
			
			DIVIDE([Rejected Claims], [Total Claims Count])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Claims
		lineageTag: 129c5699-4f39-4fd3-9f1c-5b8c205f76ca

	measure 'Avg Days to Decision' =
			
			CALCULATE(
			    AVERAGE(fact_claims[days_to_decision]),
			    fact_claims[approval_status] <> "Pending Review",
			    NOT ISBLANK(fact_claims[days_to_decision])
			)
		displayFolder: Claims
		lineageTag: 687d7847-ecb9-4ce9-81f8-16338d420076

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Decision Approval Rate %' =
			
			DIVIDE([Approved Claims] + [Partially Approved Claims], [Decided Claims])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Claims
		lineageTag: 46adaefa-b939-4b12-9b14-d1dd24783545

	measure 'Decision Rejection Rate %' =
			
			DIVIDE([Rejected Claims], [Decided Claims])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Claims
		lineageTag: f712543b-8dcc-4ec7-b00a-40d2569d6924

	measure 'Pharmacy Transactions' =
			
