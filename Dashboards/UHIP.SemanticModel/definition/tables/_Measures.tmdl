	measure 'Forecasted Visits' =
			
			VAR LastDate_ =
			    MAX(dim_date[full_date])
			
			VAR Last3MonthsDates =
			    DATESINPERIOD(
			        dim_date[full_date],
			        LastDate_,
			        -3,
			        MONTH
			    )
			
			VAR MonthlyVisitsTable =
			    CALCULATETABLE(
			        SUMMARIZE(
			            dim_date,
			            dim_date[year],
			            dim_date[month],
			            "MonthlyVisits", [Total Visits]
			        ),
			        Last3MonthsDates
			    )
			
			RETURN
			AVERAGEX(
			    MonthlyVisitsTable,
			    [MonthlyVisits]
			)
		displayFolder: Forecast & Early Warning
		lineageTag: b04fac9e-8389-41f1-abef-499258dee2e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecasted Claims' =
			
			VAR LastDate_ =
			    MAX(dim_date[full_date])
			
			VAR Last3MonthsDates =
			    DATESINPERIOD(
			        dim_date[full_date],
			        LastDate_,
			        -3,
			        MONTH
			    )
			
			VAR MonthlyClaimsTable =
			    CALCULATETABLE(
			        SUMMARIZE(
			            dim_date,
			            dim_date[year],
			            dim_date[month],
			            "MonthlyClaims", [Total Claims Count]
			        ),
			        Last3MonthsDates
			    )
			
			RETURN
			AVERAGEX(
			    MonthlyClaimsTable,
			    [MonthlyClaims]
			)
		displayFolder: Forecast & Early Warning
		lineageTag: 9fa5da7c-77f0-4ee4-92ee-667d80fb7b07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecasted Pharmacy Demand' =
			
			VAR LastDate_ =
			    MAX(dim_date[full_date])
			
			VAR Last3MonthsDates =
			    DATESINPERIOD(
			        dim_date[full_date],
			        LastDate_,
			        -3,
			        MONTH
			    )
			
			VAR MonthlyPharmacyTable =
			    CALCULATETABLE(
			        SUMMARIZE(
			            dim_date,
			            dim_date[year],
			            dim_date[month],
			            "MonthlyQuantity", [Total Quantity]
			        ),
			        Last3MonthsDates
			    )
			
			RETURN
			AVERAGEX(
			    MonthlyPharmacyTable,
			    [MonthlyQuantity]
			)
		displayFolder: Forecast & Early Warning
		lineageTag: 63c3ac53-3aa9-4b65-90a2-7fb60827e7d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Expected Stockout Risk' =
			
			[Stockout Rate]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Forecast & Early Warning
		lineageTag: e66a6ab0-fa14-4d56-89a9-5a5390a649a7

	measure 'Hospital Load Index' =
			
			DIVIDE(
			    [Total Visits],
			    [Total beds]
			)
		displayFolder: Forecast & Early Warning
		lineageTag: 48f9cb90-57bc-4e16-9111-d92c8e76a6e4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Healthcare Pressure Score' =
			
			VAR WaitingScore = MIN(100, DIVIDE([Avg Waiting Time - Completed], 120) * 100)
			VAR LoadScore = MIN(100, [Hospital Load Index] * 100)
			VAR NoShowScore = COALESCE([No-Show Rate %], 0) -- keep as 0-100 if your old measure multiplies by 100
			RETURN 0.50 * WaitingScore + 0.30 * LoadScore + 0.20 * NoShowScore
		displayFolder: Forecast & Early Warning
		lineageTag: e8208c88-6813-403c-9605-7836d3316c13

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Expected Hospital Pressure' =
			
			[Healthcare Pressure Score]
		displayFolder: Forecast & Early Warning
		lineageTag: 44724fb7-f8d0-431e-9cea-e44bb3929ca1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Early Warning Score' =
			
			VAR RiskScore =
			    COALESCE([Overall Risk Score], 0)
			
			VAR PressureScore =
			    COALESCE([Expected Hospital Pressure], 0)
			
			VAR StockRiskScore =
			    COALESCE([Expected Stockout Risk], 0) * 100
			
			VAR Score =
			    0.40 * RiskScore +
			    0.35 * PressureScore +
			    0.25 * StockRiskScore
			
			RETURN
			MIN(
			    100,
			    Score
			)
		displayFolder: Forecast & Early Warning
		lineageTag: 4b498fd7-a4ba-4d41-8b16-7d24d9fd3a0e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	changedProperty = Name

	annotation PBI_ResultType = Table

