		lineageTag: f91c7067-4584-491f-9c4c-1b005aa2b279

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Approval Gap Rate %' =
			
			DIVIDE([Approval Gap], [Total Claimed Amount])
