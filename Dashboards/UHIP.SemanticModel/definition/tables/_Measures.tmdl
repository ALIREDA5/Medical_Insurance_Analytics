		lineageTag: 5e264be6-607f-460b-8bae-790a6004b516

	measure 'No Prescription Rate' =
			
			DIVIDE([No Prescription Transactions], [Pharmacy Transactions])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Pharmacy
		lineageTag: 173a183a-d4e8-4409-be8a-ef1dd467e51d

	measure 'Stockout Transactions' =
			
			SUM(fact_pharmacy[stockout_flag])
		formatString: 0
		displayFolder: Pharmacy
		lineageTag: 028d9b0a-d223-42db-86b9-5aaa4650cead

	measure 'Stockout Rate' =
			
			DIVIDE([Stockout Transactions], [Pharmacy Transactions])
		formatString: 0.0%;-0.0%;0.0%
